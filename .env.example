# ── Platform Affiliate Links ───────────────────────────────────────────────────
# Set these to your personal affiliate tracking URLs from each program.
# If a variable is omitted the code falls back to the direct (non-tracked) URL.
#
# Chaturbate — sign up at https://chaturbate.com/affiliates/
#   Dashboard → "Cam Model Referral" → copy your unique link (contains tour= & campaign=)
NEXT_PUBLIC_CB_AFFILIATE_URL=https://chaturbate.com/in/?tour=OT2s&campaign=YOUR_CAMPAIGN_ID&track=default
#
# OnlyFans — sign up at https://onlyfans.com (create a creator referral in your account settings)
#   Settings → Referrals → copy your ref link (contains ?ref=YOUR_ID)
NEXT_PUBLIC_OF_AFFILIATE_URL=https://onlyfans.com?ref=YOUR_REF_ID
#
# Stripchat — sign up at https://stripchat.com/affiliates/
#   Dashboard → "Get Link" → copy your tracking URL
NEXT_PUBLIC_SC_AFFILIATE_URL=https://stripchat.com/join?from=YOUR_AFFILIATE_ID
#
# Cam4 — sign up at https://www.cam4.com/affiliates
#   Dashboard → "Referral Links" → copy your link (format: cam4.com/r/YOUR_CODE)
NEXT_PUBLIC_C4_AFFILIATE_URL=https://cam4.com/r/YOUR_AFFILIATE_CODE
#
# ManyVids — sign up at https://www.manyvids.com/affiliates
#   Dashboard → "Links" → copy your unique affiliate URL
NEXT_PUBLIC_MV_AFFILIATE_URL=https://www.manyvids.com/?aff=YOUR_AFFILIATE_ID
#
# IWantClips — sign up at https://www.iwantclips.com/affiliate
#   Dashboard → "My Links" → copy your referral URL
NEXT_PUBLIC_IW_AFFILIATE_URL=https://iwantclips.com/?ref=YOUR_REF_ID
#
# LoyalFans — sign up at https://loyalfans.com/affiliates
#   Dashboard → "Affiliate Links" → copy your tracked link
NEXT_PUBLIC_LF_AFFILIATE_URL=https://loyalfans.com/?ref=YOUR_REF_ID
#
# SkyPrivate — sign up at https://www.skyprivate.com/affiliates
#   Dashboard → "Referral" → copy your affiliate link
NEXT_PUBLIC_SP_AFFILIATE_URL=https://www.skyprivate.com/?ref=YOUR_REF_ID

# ── Registration Form ──────────────────────────────────────────────────────────
# Formspree receives form submissions and emails them to you (free tier: 50/mo)
# 1. Go to https://formspree.io and sign up free
# 2. Click "New Form", give it a name, copy the Form ID (e.g. xpwzabcd)
# 3. Add it below — applications will be emailed to your Formspree account email
NEXT_PUBLIC_FORMSPREE_ID=xpwzabcd

# ── Ad Networks ────────────────────────────────────────────────────────────────
# TrafficJunky — https://www.trafficjunky.com
NEXT_PUBLIC_TJ_PUBLISHER_ID=123456
NEXT_PUBLIC_TJ_ZONE_BANNER=789012
NEXT_PUBLIC_TJ_ZONE_RECT=789013

# ExoClick — https://www.exoclick.com
NEXT_PUBLIC_USE_EXOCLICK=false
NEXT_PUBLIC_EXO_ZONE_BANNER=4000000
NEXT_PUBLIC_EXO_ZONE_RECT=4000001
